#!/sbin/sh

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

# Magisk
if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit 0
fi

# APatch / 其他兼容管理器
if [ -f /data/adb/apd ]; then
  echo "! 请使用管理器界面安装本模块"
  exit 0
fi

echo "! 未找到模块安装环境，请通过 KernelSU 管理器刷入"
exit 1
