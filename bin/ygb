#!/system/bin/sh
# 姚广孝 BOSS · 核心控制脚本
# 用法: ygb {status|ui-status|build|apply|on|off|add <域名>|del <域名>|white-add <域名>|white-del <域名>|reload|reset}

# ---------- 定位模块目录 ----------
if [ -z "$MODDIR" ]; then
  MODDIR=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)
fi
[ -f "$MODDIR/module.prop" ] || MODDIR=/data/adb/modules/yaoguangxiao_boss

# KSU WebUI / 管理器执行时环境变量可能极简，显式补全 PATH，避免 date/awk/grep 找不到
PATH=/system/bin:/system/xbin:/system/sbin:/data/adb/ksu/bin:/data/adb/magisk:/usr/bin:/bin:$PATH
export PATH

BASE_LIST="$MODDIR/lists/base.txt"
BOOST_LIST="$MODDIR/lists/boost.txt"
USER_LIST="$MODDIR/lists/user.txt"
LEARNED_LIST="$MODDIR/lists/learned.txt"
WHITE_LIST="$MODDIR/lists/white.txt"
BUILD_FILE="$MODDIR/build/hosts"
FLAG_OFF="$MODDIR/state/off"
FLAG_BOOST_OFF="$MODDIR/state/boost_off"
LOG_FILE="$MODDIR/logs/apply.log"
# 兼容 system-as-root / 传统分区两种布局
if [ -f /system/etc/hosts ]; then
  TARGET=/system/etc/hosts
elif [ -f /system_root/system/etc/hosts ]; then
  TARGET=/system_root/system/etc/hosts
else
  TARGET=/system/etc/hosts
fi
MARKER="yaoguangxiao-boss"

mkdir -p "$MODDIR/build" "$MODDIR/state" "$MODDIR/logs" 2>/dev/null

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
  # 日志超过 200 行时裁剪
  if [ "$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)" -gt 200 ]; then
    tail -n 150 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null && mv "$LOG_FILE.tmp" "$LOG_FILE"
  fi
}

# ---------- 生成 hosts ----------
build_hosts() {
  mkdir -p "$MODDIR/build"
  [ -f "$BASE_LIST" ] || : > "$BASE_LIST"
  [ -f "$BOOST_LIST" ] || : > "$BOOST_LIST"
  [ -f "$USER_LIST" ] || : > "$USER_LIST"
  [ -f "$WHITE_LIST" ] || : > "$WHITE_LIST"

  {
    echo "# ================================================"
    echo "# $MARKER · 姚广孝 BOSS 广告拦截规则"
    echo "# 生成时间: $(date '+%Y-%m-%d %H:%M:%S')"
    srcs="lists/base.txt(精选)"
    [ -f "$FLAG_BOOST_OFF" ] || srcs="$srcs + lists/boost.txt(增强)"
    srcs="$srcs + lists/user.txt(自定义)"
    [ -s "$LEARNED_LIST" ] && srcs="$srcs + lists/learned.txt(自动学习)"
    echo "# 规则来源: $srcs"
    if [ -f "$FLAG_BOOST_OFF" ]; then
      echo "# 强力模式: 关"
    else
      echo "# 强力模式: 开"
    fi
    echo "# ================================================"
    echo "127.0.0.1 localhost"
    echo "::1 localhost"
    {
      cat "$BASE_LIST" 2>/dev/null
      [ -f "$FLAG_BOOST_OFF" ] || cat "$BOOST_LIST" 2>/dev/null
      cat "$USER_LIST" 2>/dev/null
      cat "$LEARNED_LIST" 2>/dev/null
    } | awk -v wf="$WHITE_LIST" '
      # 后缀匹配：白名单 *.foo.com 放行 foo.com 及其全部子域
      function sfx(d, s) {
        if (d == s) return 1
        if (length(d) >= length(s) + 2 &&
            substr(d, length(d) - length(s), length(s) + 1) == "." s) return 1
        return 0
      }
      BEGIN {
        while ((getline l < wf) > 0) {
          gsub(/\r/, "", l); sub(/^[ \t]*/, "", l); sub(/[ \t]*$/, "", l)
          if (l == "" || l ~ /^#/) continue
          l = tolower(l); sub(/\/.*/, "", l)
          if (l ~ /^\*\./) wsfx[substr(l, 3)] = 1
          else wex[l] = 1
        }
      }
      {
        gsub(/\r/, "")
        sub(/^[ \t]*/, "", $0); sub(/[ \t]*$/, "", $0)
        if ($0 == "" || $0 ~ /^#/) next
        d = tolower($0)
        sub(/^https?:\/\//, "", d)
        sub(/\/.*/, "", d)
        if (d !~ /^[a-z0-9*._-]+$/) next
        b = d; sub(/^\*\./, "", b)
        # 白名单精确 / 通配命中 -> 跳过
        if (d in wex || b in wex) next
        skip = 0
        for (k in wsfx) if (sfx(d, k) || sfx(b, k)) { skip = 1; break }
        if (skip) next
        # hosts 不支持通配符，写主体域名
        if (b in seen) next
        seen[b] = 1
        printf "0.0.0.0 %s\n::1 %s\n", b, b
      }'
  } > "$BUILD_FILE.tmp.$$" 2>/dev/null

  if [ -s "$BUILD_FILE.tmp.$$" ]; then
    # 原地覆盖（不用 mv）：保持 inode，已挂载的 bind mount 立即读到新规则
    cat "$BUILD_FILE.tmp.$$" > "$BUILD_FILE"
    rm -f "$BUILD_FILE.tmp.$$"
    log "规则已生成: $(count_rules) 条域名"
    # 有些 ROM / 命名空间下，原地写入不会传回已挂载的文件；
    # 这里在有挂载时重建一次绑定，保证「刚学的规则立刻生效」而不是等重启。
    refresh_mount
  else
    rm -f "$BUILD_FILE.tmp.$$"
    log "规则生成失败"
    return 1
  fi
}

# ---------- 挂载 / 卸载 ----------
refresh_mount() {
  mount 2>/dev/null | grep -q " $TARGET " || return 0
  umount "$TARGET" 2>/dev/null
  umount -l "$TARGET" 2>/dev/null
  mount -o bind "$BUILD_FILE" "$TARGET" 2>/dev/null && log "挂载已刷新 -> $TARGET"
  return 0
}

LOCK_DIR="$MODDIR/state/.lock"
LOCK_DEPTH=0
acquire_lock() {
  if [ "$LOCK_DEPTH" -gt 0 ]; then
    LOCK_DEPTH=$((LOCK_DEPTH + 1))
    return 0
  fi
  i=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    holder=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null && rm -rf "$LOCK_DIR" 2>/dev/null
    i=$((i + 1))
    if [ "$i" -gt 60 ]; then
      rm -rf "$LOCK_DIR" 2>/dev/null
      mkdir "$LOCK_DIR" 2>/dev/null
      break
    fi
    sleep 0.2
  done
  echo $$ > "$LOCK_DIR/pid" 2>/dev/null
  LOCK_DEPTH=1
}
release_lock() {
  [ "$LOCK_DEPTH" -gt 0 ] || return 0
  LOCK_DEPTH=$((LOCK_DEPTH - 1))
  [ "$LOCK_DEPTH" -eq 0 ] && rm -rf "$LOCK_DIR" 2>/dev/null
  return 0
}
trap 'release_lock' EXIT INT TERM
is_mounted() {
  [ -f "$TARGET" ] && grep -q "$MARKER" "$TARGET" 2>/dev/null
}

mount_hosts() {
  acquire_lock
  if [ -f "$FLAG_OFF" ]; then
    release_lock
    log "已处于暂停状态，跳过挂载"
    return 0
  fi
  [ -s "$BUILD_FILE" ] || build_hosts || { release_lock; return 1; }

  # 已挂载且内容正确：原地刷新已生效，无需重复绑定（避免叠层）
  if is_mounted; then
    release_lock
    log "hosts 已在位，无需重复挂载"
    return 0
  fi

  # 解除异常残留，保证只有一个挂载层
  umount "$TARGET" 2>/dev/null
  umount -l "$TARGET" 2>/dev/null
  i=0
  while [ $i -lt 8 ]; do
    if mount -o bind "$BUILD_FILE" "$TARGET" 2>/dev/null; then
      if is_mounted; then
        release_lock
        log "挂载成功 -> $TARGET"
        return 0
      fi
      umount "$TARGET" 2>/dev/null
    fi
    i=$((i + 1))
    sleep 0.3
  done
  release_lock
  log "挂载失败（部分系统分区可能只读，重启后由 post-fs-data 重试）"
  return 1
}

unmount_hosts() {
  acquire_lock
  umount "$TARGET" 2>/dev/null
  umount -l "$TARGET" 2>/dev/null
  release_lock
  log "已解除 hosts 挂载"
}

# ---------- 状态 ----------
count_rules() {
  [ -f "$BUILD_FILE" ] || { echo 0; return; }
  n=$(grep -c '^0.0.0.0 ' "$BUILD_FILE" 2>/dev/null)
  [ -z "$n" ] && n=0
  echo "$n"
}

count_valid() {
  [ -f "$1" ] || { echo 0; return; }
  grep -v -E '^[[:space:]]*$|^[[:space:]]*#' "$1" 2>/dev/null \
    | tr 'A-Z' 'a-z' \
    | sed -e 's|^https\?://||' -e 's|/.*||' -e 's|^[[:space:]]*||' -e 's|[[:space:]]*$||' \
    | grep -E '^[a-z0-9*._-]+$' | sort -u | wc -l | tr -d ' '
}

state_on() {
  [ -f "$FLAG_OFF" ] && echo "off" || echo "on"
}

do_status() {
  echo "模块: 姚广孝 BOSS"
  echo "状态: $( [ "$(state_on)" = on ] && echo '开启' || echo '已暂停' )"
  echo "挂载: $( is_mounted && echo 'yes' || echo 'no' )"
  if [ -f "$FLAG_OFF" ]; then
    echo "拦截域名: 0（总开关已关闭，全部规则停用，系统 hosts 已还原）"
  else
    echo "拦截域名: $(count_rules)"
  fi
  echo "精选规则: $(count_valid "$BASE_LIST")"
  if [ -f "$FLAG_BOOST_OFF" ]; then
    echo "增强规则: 0（强力模式: 关，已不参与拦截）"
  else
    echo "增强规则: $(count_valid "$BOOST_LIST")（强力模式: 开）"
  fi
  echo "自定义规则: $(count_valid "$USER_LIST")"
  echo "白名单: $(count_valid "$WHITE_LIST")"
}

do_ui_status() {
  [ -s "$BUILD_FILE" ] || build_hosts >/dev/null 2>&1
  m=$(is_mounted && echo "yes" || echo "no")
  if [ -f "$FLAG_BOOST_OFF" ]; then
    bcnt=0
  else
    bcnt=$(count_valid "$BOOST_LIST")
  fi
  if [ -f "$FLAG_OFF" ]; then
    rcnt=0; ccnt=0
  else
    rcnt=$(count_rules); ccnt=$(count_valid "$USER_LIST")
  fi
  learned=$(count_valid "$LEARNED_LIST")
  cand=$( [ -f "$MODDIR/state/learn.cand" ] && cut -f1 "$MODDIR/state/learn.cand" | sort -u | wc -l | tr -d ' ' || echo 0)
  auto=$( [ -f "$MODDIR/state/learn_auto" ] && echo 1 || echo 0 )
  printf '{"state":"%s","mounted":"%s","rules":%s,"base":%s,"boost":%s,"boostOn":%s,"custom":%s,"white":%s,"learned":%s,"cand":%s,"learnAuto":%s,"time":"%s"}\n' \
    "$(state_on)" "$m" "$rcnt" "$(count_valid "$BASE_LIST")" "$bcnt" \
    "$( [ -f "$FLAG_BOOST_OFF" ] && echo 0 || echo 1 )" \
    "$ccnt" "$(count_valid "$WHITE_LIST")" "$learned" "$cand" "$auto" \
    "$(date '+%H:%M:%S')"
}

# ---------- 规则操作 ----------
normalize() {
  echo "$1" | tr 'A-Z' 'a-z' | sed -e 's|^https\?://||' -e 's|/.*||' -e 's|^[[:space:]]*||' -e 's|[[:space:]]*$||'
}

# 追加一行，自动补齐缺失的结尾换行（否则会拼到上一行甚至变成注释）
append_line() {
  af="$1"; al="$2"
  [ -f "$af" ] || : > "$af"
  if [ -s "$af" ]; then
    lastn=$(tail -c 1 "$af" 2>/dev/null | wc -l | tr -d ' ')
    [ "$lastn" = "0" ] && echo >> "$af"
  fi
  printf '%s\n' "$al" >> "$af"
}

valid_domain() {
  case "$1" in
    ''|.*|*..*|*[!a-z0-9._*-]*) return 1 ;;
    *) return 0 ;;
  esac
}

do_add() {
  d=$(normalize "$1")
  [ -z "$d" ] && { echo "ERR 域名不能为空"; return 1; }
  valid_domain "$d" || { echo "ERR 非法域名: $d"; return 1; }
  if grep -qxF "$d" "$USER_LIST" 2>/dev/null; then
    echo "OK 已存在: $d"
    return 0
  fi
  acquire_lock
  append_line "$USER_LIST" "$d"
  build_hosts
  release_lock
  mount_hosts >/dev/null 2>&1
  echo "OK 已添加: $d"
}

do_del() {
  d=$(normalize "$1")
  [ -z "$d" ] && { echo "ERR 域名不能为空"; return 1; }
  acquire_lock
  grep -vx "$d" "$USER_LIST" > "$USER_LIST.tmp" 2>/dev/null
  mv "$USER_LIST.tmp" "$USER_LIST"
  build_hosts
  release_lock
  mount_hosts >/dev/null 2>&1
  echo "OK 已移除: $d"
}

do_white_add() {
  d=$(normalize "$1")
  [ -z "$d" ] && { echo "ERR 域名不能为空"; return 1; }
  valid_domain "$d" || { echo "ERR 非法域名: $d"; return 1; }
  acquire_lock
  grep -qxF "$d" "$WHITE_LIST" 2>/dev/null || append_line "$WHITE_LIST" "$d"
  build_hosts
  release_lock
  mount_hosts >/dev/null 2>&1
  echo "OK 已加入白名单: $d"
}

do_white_del() {
  d=$(normalize "$1")
  [ -z "$d" ] && { echo "ERR 域名不能为空"; return 1; }
  acquire_lock
  grep -vx "$d" "$WHITE_LIST" > "$WHITE_LIST.tmp" 2>/dev/null
  mv "$WHITE_LIST.tmp" "$WHITE_LIST"
  build_hosts
  release_lock
  mount_hosts >/dev/null 2>&1
  echo "OK 已移出白名单: $d"
}

# ---------- 在线更新（GitHub） ----------
UPDATE_BASE_DEFAULT="https://raw.githubusercontent.com/wumisc/yaoguangxiao-boss/main"
UPDATE_URL_FILE="$MODDIR/state/update_url"
update_base() {
  if [ -f "$UPDATE_URL_FILE" ]; then
    u=$(tr -d '\r\n' < "$UPDATE_URL_FILE" | sed 's|^[[:space:]]*||;s|[[:space:]]*$||')
    while case "$u" in */) true ;; *) false ;; esac; do u=${u%/}; done
    case "$u" in https://*) printf '%s\n' "$u"; return 0 ;; esac
  fi
  printf '%s\n' "$UPDATE_BASE_DEFAULT"
}
UPDATE_LOG="$MODDIR/logs/update.log"
VER_FILE="$MODDIR/state/rules.ver"

ulog() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$UPDATE_LOG"
  [ "$(wc -l < "$UPDATE_LOG" 2>/dev/null || echo 0)" -gt 200 ] && {
    tail -n 120 "$UPDATE_LOG" > "$UPDATE_LOG.t" 2>/dev/null && mv "$UPDATE_LOG.t" "$UPDATE_LOG"
  }
}

# 取一个 URL 到 stdout。只支持 https，且有 curl / wget / busybox 三条路。
fetch_url() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 8 --max-time 25 "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O - --timeout=25 "$1" 2>/dev/null
  elif command -v busybox >/dev/null 2>&1; then
    busybox wget -q -O - "$1" 2>/dev/null
  else
    return 127
  fi
}

sha_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  elif command -v busybox >/dev/null 2>&1; then
    busybox sha256sum "$1" 2>/dev/null | awk '{print $1}'
  fi
}

# manifest.txt 格式（刻意做成一行一条，不依赖 jq）：
#   version=10075
#   base.txt 251 sha256=<64位>
#   boost.txt 15364 sha256=<...>
#   white.txt 97 sha256=<...>
do_update() {
  : > "$UPDATE_LOG" 2>/dev/null
  if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1 && ! command -v busybox >/dev/null 2>&1; then
    echo "ERR 本机没有 curl/wget，无法联网更新"
    return 1
  fi

  TMP="$MODDIR/state/update"
  rm -rf "$TMP"; mkdir -p "$TMP" 2>/dev/null

  BASE=$(update_base)
  fetch_url "$BASE/updates/manifest.txt" > "$TMP/manifest.txt"
  if [ ! -s "$TMP/manifest.txt" ]; then
    ulog "拉取 manifest 失败：$BASE"
    echo "ERR 拉不到更新清单（网络不通，或更新源还没发布 manifest）"
    return 1
  fi

  remote=$(sed -n 's/^version=//p' "$TMP/manifest.txt" | head -1 | tr -dc '0-9')
  if [ -z "$remote" ]; then
    echo "ERR manifest 格式不对"
    return 1
  fi
  local_ver=$(cat "$VER_FILE" 2>/dev/null | tr -dc '0-9')
  [ -z "$local_ver" ] && local_ver=0
  if [ "$remote" -le "$local_ver" ]; then
    echo "OK 已是最新（本地 $local_ver，远端 $remote）"
    ulog "已是最新 v$local_ver"
    rm -rf "$TMP"
    return 0
  fi

  grep -E '^[A-Za-z0-9._-]+ [0-9]+ sha256=[0-9a-f]{64}$' "$TMP/manifest.txt" > "$TMP/plan"
  if [ ! -s "$TMP/plan" ]; then
    echo "ERR manifest 里没有可用的文件条目"
    return 1
  fi

  ok=0
  while read -r name count hash; do
    hash=${hash#sha256=}
    fetch_url "$BASE/lists/$name" > "$TMP/$name"
    if [ ! -s "$TMP/$name" ]; then
      ulog "$name 下载失败"
      echo "ERR $name 下载失败"
      return 1
    fi
    actual_sha=$(sha_of "$TMP/$name")
    if [ "$actual_sha" != "$hash" ]; then
      ulog "$name 校验失败：$actual_sha != $hash"
      echo "ERR $name 校验失败，已拒绝（防止被篡改/半截下载）"
      return 1
    fi
    actual_lines=$(grep -vc -E '^[[:space:]]*$|^[[:space:]]*#' "$TMP/$name" 2>/dev/null)
    if [ "$actual_lines" != "$count" ]; then
      ulog "$name 行数不符：$actual_lines != $count"
      echo "ERR $name 行数不符（$actual_lines/$count），已拒绝"
      return 1
    fi
    ok=$((ok + 1))
  done < "$TMP/plan"

  # 备份 -> 原子替换
  BK="$MODDIR/state/backup/$remote"
  mkdir -p "$BK" 2>/dev/null
  for f in base.txt boost.txt white.txt; do
    [ -f "$MODDIR/lists/$f" ] && cp "$MODDIR/lists/$f" "$BK/$f" 2>/dev/null
  done

  while read -r name count hash; do
    cp "$TMP/$name" "$MODDIR/lists/$name.new" 2>/dev/null &&
      mv "$MODDIR/lists/$name.new" "$MODDIR/lists/$name" 2>/dev/null || {
        echo "ERR 写入 $name 失败"; return 1
      }
  done < "$TMP/plan"

  echo "$remote" > "$VER_FILE"
  date +%s > "$MODDIR/state/update.at"
  rm -rf "$TMP"

  build_hosts >/dev/null 2>&1
  mount_hosts >/dev/null 2>&1
  ulog "更新到 v$remote：$ok 个文件"
  echo "OK 已更新到 v$remote（$ok 个文件，旧版备份在 state/backup/$remote）"
  return 0
}

do_update_info() {
  echo "本地版本: $(cat "$VER_FILE" 2>/dev/null || echo 未初始化)"
  echo "上次检查: $( [ -f "$MODDIR/state/update.at" ] && date -r "$MODDIR/state/update.at" '+%Y-%m-%d %H:%M' 2>/dev/null || echo 从未)"
  echo "自动检查: $( [ -f "$MODDIR/state/auto_update" ] && echo 开 || echo 关)"
  echo "自动检查间隔: 24 小时（开机时判一次）"
  echo "更新源: $(update_base)"
  echo "-- 最近日志 --"
  tail -n 8 "$UPDATE_LOG" 2>/dev/null
}

# ---------- 主入口 ----------
case "$1" in
  status)      do_status ;;
  ui-status)   do_ui_status ;;
  build)       build_hosts ;;
  mount)       mount_hosts ;;
  unmount)     unmount_hosts ;;
  apply|reload) build_hosts && mount_hosts ;;
  on)          rm -f "$FLAG_OFF"; build_hosts && mount_hosts; echo "OK 拦截已开启" ;;
  off)         touch "$FLAG_OFF"; unmount_hosts; build_hosts >/dev/null 2>&1
               echo "OK 总开关已关闭：全部规则停用，系统 hosts 已还原（重启后保持关闭）" ;;
  boost-on)    rm -f "$FLAG_BOOST_OFF"; build_hosts && mount_hosts; echo "OK 强力模式已开启" ;;
  boost-off)   touch "$FLAG_BOOST_OFF"; build_hosts && mount_hosts; echo "OK 强力模式已关闭（仅保留精选规则）" ;;
  add)         do_add "$2" ;;
  del)         do_del "$2" ;;
  white-add)   do_white_add "$2" ;;
  white-del)   do_white_del "$2" ;;
  list)        [ -f "$USER_LIST" ] && grep -v -E '^[[:space:]]*$|^[[:space:]]*#' "$USER_LIST" ;;
  white)       [ -f "$WHITE_LIST" ] && grep -v -E '^[[:space:]]*$|^[[:space:]]*#' "$WHITE_LIST" ;;
  logs)        tail -n 60 "$LOG_FILE" 2>/dev/null ;;
  reset)       : > "$USER_LIST"; build_hosts && mount_hosts; echo "OK 自定义规则已清空" ;;
  learn-cand)
               [ -f "$MODDIR/state/learn.cand" ] || exit 0
               awk -F'\t' '{c[$1]++; p[$1]=p[$1]" "$2} END {for (d in c) printf "%s\t%s\t%s\n", d, c[d], p[d]}' \
                 "$MODDIR/state/learn.cand" | sort -t'	' -k2,2nr | head -15 ;;
  learn-ignore)
               d=$(printf %s "$2" | tr 'A-Z' 'a-z')
               [ -z "$d" ] && { echo "ERR 域名不能为空"; exit 1; }
               mkdir -p "$MODDIR/state"
               grep -qxF "$d" "$MODDIR/state/learn.rej" 2>/dev/null || echo "$d" >> "$MODDIR/state/learn.rej"
               if [ -f "$MODDIR/state/learn.cand" ]; then
                 grep -v "^$d	" "$MODDIR/state/learn.cand" > "$MODDIR/state/learn.cand.t" 2>/dev/null || :
                 mv "$MODDIR/state/learn.cand.t" "$MODDIR/state/learn.cand" 2>/dev/null
               fi
               echo "OK 已忽略候选: $d" ;;
  learn-list)  [ -f "$LEARNED_LIST" ] && grep -v -E '^[[:space:]]*$|^[[:space:]]*#' "$LEARNED_LIST"
               echo "-- 候选（未确认）--"
               [ -f "$MODDIR/state/learn.cand" ] && cut -f1 "$MODDIR/state/learn.cand" | sort | uniq -c | sort -rn | head -20 ;;
  learn-clear) : > "$LEARNED_LIST"; rm -f "$MODDIR/state/learn.cand"; build_hosts && mount_hosts
               echo "OK 学习结果已清空（规则与候选都清了）" ;;
  learn-auto-on)  mkdir -p "$MODDIR/state"; : > "$MODDIR/state/learn_auto"
               echo "OK 学习器已切到自动生效：确认的域名会直接进 hosts" ;;
  learn-auto-off) rm -f "$MODDIR/state/learn_auto"
               echo "OK 学习器只收集不生效（推荐）" ;;
  learn)       sh "$MODDIR/bin/adlearn" "$2" ;;
  update)      do_update ;;
  update-info) do_update_info ;;
  update-auto-on)  mkdir -p "$MODDIR/state"; : > "$MODDIR/state/auto_update"
               echo "OK 已开启开机自动检查（每天最多一次）" ;;
  update-auto-off) rm -f "$MODDIR/state/auto_update"
               echo "OK 已关闭开机自动检查" ;;
  update-url)  u=$(printf '%s' "$2" | tr -d '\r\n' | sed 's|^[[:space:]]*||;s|[[:space:]]*$||')
               while case "$u" in */) true ;; *) false ;; esac; do u=${u%/}; done
               case "$u" in
                 "") echo "用法: ygb update-url https://raw.githubusercontent.com/<user>/<repo>/<branch>" ;;
                 https://*) case "$u" in *[!a-zA-Z0-9._:/@-]*) echo "ERR 更新源里含非法字符" ;;
                            *) mkdir -p "$MODDIR/state"; printf '%s\n' "$u" > "$UPDATE_URL_FILE"
                               echo "OK 更新源已设为: $u" ;; esac ;;
                 file://*|http://*) echo "ERR 只接受 https 源" ;;
                 *) echo "ERR 只接受 https 源" ;;
               esac ;;
  "")
    do_status ;;
  *)
    echo "姚广孝 BOSS · 用法:"
    echo "  ygb status | ui-status | build | apply | on | off | boost-on/off"
    echo "  ygb add <域名> | del <域名> | white-add <域名> | white-del <域名>"
    echo "  ygb learn <包名> | learn-list | learn-clear | learn-auto-on/off"
    echo "  ygb update | update-info | update-auto-on/off | update-url <https地址>"
    ;;
esac
